# Copy to .env (git-ignored) and fill in. All are free. A missing value skips
# that data source for the run; it never crashes the pipeline.
FRED_API_KEY=your_fred_key_here
FINNHUB_API_KEY=your_finnhub_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here
# SEC asks for a descriptive User-Agent with a contact email.
SEC_USER_AGENT=ai-hedgefund class project your_email@example.com
